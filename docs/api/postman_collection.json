{
  "info": {
    "_postman_id": "axn-pm-01-collection",
    "name": "AXN-PM-01 — Product Management System",
    "description": "API collection for the Axone Infotech Product Management (License Server) system.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "License Verification API",
      "item": [
        {
          "name": "Identify Customer — Active Device",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"db_name\": \"{{db_name}}\",\n  \"device_fingerprint\": \"{{device_fingerprint}}\",\n  \"public_ip\": \"{{public_ip}}\",\n  \"local_ip\": \"{{local_ip}}\",\n  \"device_uuid\": \"{{device_uuid}}\",\n  \"cpu_processor_id\": \"{{cpu_processor_id}}\",\n  \"motherboard_serial_number\": \"{{motherboard_serial_number}}\",\n  \"primary_disk_serial_number\": \"{{primary_disk_serial_number}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/identify-customer",
              "host": ["{{base_url}}"],
              "path": ["api", "identify-customer"]
            },
            "description": "Verifies an existing device's subscription and returns access rights."
          }
        },
        {
          "name": "Identify Customer — New Device Registration",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"db_name\": \"{{db_name}}\",\n  \"device_fingerprint\": \"NEW_UNIQUE_FINGERPRINT_001\",\n  \"public_ip\": \"1.2.3.4\",\n  \"local_ip\": \"192.168.1.100\",\n  \"device_uuid\": \"XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX\",\n  \"cpu_processor_id\": \"BFEBFBFF000906EA\",\n  \"motherboard_serial_number\": \"MB123456\",\n  \"primary_disk_serial_number\": \"DISK987654\",\n  \"first_name\": \"John\",\n  \"last_name\": \"Doe\",\n  \"email\": \"john.doe@client.com\",\n  \"phone\": \"9876543210\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/identify-customer",
              "host": ["{{base_url}}"],
              "path": ["api", "identify-customer"]
            },
            "description": "Registers a new device and verifies subscription. Requires user details."
          }
        },
        {
          "name": "Identify Customer — Invalid DB Name",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"db_name\": \"nonexistent_db\",\n  \"device_fingerprint\": \"some_fingerprint\",\n  \"public_ip\": \"1.2.3.4\",\n  \"local_ip\": \"192.168.1.1\",\n  \"device_uuid\": \"test\",\n  \"cpu_processor_id\": \"test\",\n  \"motherboard_serial_number\": \"test\",\n  \"primary_disk_serial_number\": \"test\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/identify-customer",
              "host": ["{{base_url}}"],
              "path": ["api", "identify-customer"]
            },
            "description": "Tests 404 response for unknown db_name."
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost/Product-management/public",
      "description": "Base URL of the application. Change for staging/production."
    },
    {
      "key": "db_name",
      "value": "test_client_db",
      "description": "The db_name value from customer_products table."
    },
    {
      "key": "device_fingerprint",
      "value": "EXISTING_DEVICE_FINGERPRINT_HASH",
      "description": "Hardware fingerprint of an already-registered device."
    },
    {
      "key": "public_ip",
      "value": "1.2.3.4"
    },
    {
      "key": "local_ip",
      "value": "192.168.1.10"
    },
    {
      "key": "device_uuid",
      "value": "XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX"
    },
    {
      "key": "cpu_processor_id",
      "value": "BFEBFBFF000906EA"
    },
    {
      "key": "motherboard_serial_number",
      "value": "MB-SERIAL-001"
    },
    {
      "key": "primary_disk_serial_number",
      "value": "DISK-SERIAL-001"
    }
  ]
}
